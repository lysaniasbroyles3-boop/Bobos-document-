@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
    --bg: #090910;
    --panel: #11111c;
    --panel2: #171725;
    --line: #29283b;
    --text: #f5f3ff;
    --muted: #9c9ab3;
    --purple: #9b6dff;
    --green: #5fe0b1;
    --gold: #ffc66e;
    --blue: #70b8ff;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
}

button, input, textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.app-shell {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 245px;
    background: #0c0c14;
    border-right: 1px solid var(--line);
    padding: 25px 15px;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 9px 35px;
}

.brand-mark {
    display: grid;
    place-items: center;
    width: 43px;
    height: 43px;
    border-radius: 14px;
    background: linear-gradient(135deg, #b58bff, #6838ce);
    font: 700 25px 'Space Grotesk';
    box-shadow: 0 0 28px #8e58ff44;
}

.brand strong {
    display: block;
    font: 700 19px 'Space Grotesk';
    letter-spacing: 2px;
}

.brand small {
    display: block;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-top: 3px;
}

.nav-label, .eyebrow {
    font-size: 10px;
    letter-spacing: 1.7px;
    font-weight: 700;
    color: #8b88a6;
}

.nav-label {
    padding: 0 12px 12px;
}

.nav {
    border: 0;
    background: transparent;
    color: #aaa8c0;
    padding: 12px;
    border-radius: 11px;
    text-align: left;
    margin: 2px 0;
    font-size: 13px;
}

.nav:hover, .nav.active {
    background: #211832;
    color: #d9c8ff;
}

.nav.active {
    box-shadow: inset 3px 0 var(--purple);
}

.sidebar-bottom {
    margin-top: auto;
    color: #77758d;
    font-size: 11px;
    padding: 20px 10px 0;
}

.status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--green);
    border-radius: 50%;
    margin-right: 7px;
}

.main {
    min-width: 0;
    flex: 1;
    padding: 0 35px 24px;
    max-width: 1600px;
    margin: 0 auto;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 0 24px;
    border-bottom: 1px solid #1d1c2a;
    margin-bottom: 28px;
}

.topbar h1 {
    font: 600 27px 'Space Grotesk';
    margin: 5px 0 0;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.credits {
    font-size: 12px;
    color: #d5c4ff;
    background: #1e1830;
    padding: 9px 12px;
    border-radius: 10px;
}

.avatar {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #30214c;
    border: 1px solid #6c4ca2;
    font-weight: 700;
}

.page {
    display: none;
    animation: fade .25s ease;
}

.page.active {
    display: block;
}

@keyframes fade {
    from {
        opacity: .4;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: none;
    }
}

.hero {
    min-height: 290px;
    border: 1px solid #38304e;
    border-radius: 22px;
    padding: 32px 38px;
    background:
        radial-gradient(ellipse at 80% 30%, #4b2a7a55, transparent 38%),
        linear-gradient(120deg, #1b142a, #10101a 60%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
}

.hero h2 {
    font: 700 clamp(32px, 4vw, 49px)/1.06 'Space Grotesk';
    margin: 17px 0 12px;
}

.hero h2 em {
    color: #b394ff;
    font-style: normal;
}

.hero p {
    max-width: 440px;
    color: #b1adc4;
    line-height: 1.7;
    font-size: 13px;
}

.pill {
    font-size: 9px;
    letter-spacing: 1.4px;
    color: #c9adff;
    background: #39245a;
    padding: 7px 10px;
    border-radius: 20px;
    display: inline-block;
}

.orb {
    width: 190px;
    height: 190px;
    border: 1px solid #9265da77;
    border-radius: 50%;
    display: grid;
    place-items: center;
    position: relative;
    margin-right: 35px;
    background: radial-gradient(circle, #7d4dcc33, transparent 65%);
    box-shadow: 0 0 60px #8249d222;
}

.orb::before, .orb::after {
    content: "";
    position: absolute;
    border: 1px solid #a27add55;
    border-radius: 50%;
    inset: -18px;
}

.orb::after {
    inset: 13px;
    border-style: dashed;
}

.orb-inner {
    width: 100px;
    height: 100px;
    border-radius: 30px;
    display: grid;
    place-items: center;
    font: 700 58px 'Space Grotesk';
    color: white;
    background: linear-gradient(145deg, #b38aff, #6335b7);
    box-shadow: 0 0 50px #9b6dff66;
}

.orb-caption {
    position: absolute;
    bottom: -35px;
    font-size: 9px;
    letter-spacing: 2px;
    color: #b69be7;
}

.primary, .secondary {
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 12px 16px;
    font-weight: 700;
    font-size: 12px;
    transition: .2s;
}

.primary {
    background: linear-gradient(135deg, #a982ff, #7845db);
    color: white;
    box-shadow: 0 5px 20px #8953e533;
}

.primary:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
}

.secondary {
    background: #1b1a2a;
    border-color: #3b3851;
    color: #d4cde8;
}

.secondary:hover {
    border-color: #9268dc;
}

.hero .primary {
    margin-top: 10px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 20px 0 30px;
}

.stat, .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
}

.stat {
    padding: 18px;
}

.stat span {
    display: block;
    font-size: 9px;
    letter-spacing: 1.3px;
    color: var(--muted);
    font-weight: 700;
}

.stat strong {
    display: block;
    font: 600 28px 'Space Grotesk';
    margin: 11px 0 4px;
}

.stat small {
    color: #77758d;
    font-size: 11px;
}

.section-head, .panel-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 25px 0 14px;
}

.section-head h2, .panel h2 {
    font: 600 22px 'Space Grotesk';
    margin: 5px 0 0;
}

.launch-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.launch-card {
    position: relative;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
    padding: 18px;
    background: linear-gradient(150deg, #151523, #101019);
    border: 1px solid var(--line);
    border-radius: 15px;
    color: var(--text);
    min-height: 145px;
    transition: .2s;
}

.launch-card:hover {
    transform: translateY(-3px);
    border-color: #7552a8;
}

.launch-card b {
    font-size: 14px;
}

.launch-card small {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.5;
}

.launch-icon {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border-radius: 10px;
    font-size: 18px;
}

.purple { background: #30204b; color: #c7a7ff; }
.gold { background: #3a2b1a; color: var(--gold); }
.green { background: #18392f; color: var(--green); }
.blue { background: #1b2e47; color: var(--blue); }

.notice {
    display: flex;
    gap: 13px;
    margin-top: 20px;
    padding: 16px;
    background: #171525;
    border: 1px solid #39304f;
    border-radius: 13px;
    color: #c3b0f3;
}

.notice p {
    font-size: 11px;
    color: #a5a1bb;
    line-height: 1.6;
    margin: 5px 0 0;
}

.panel {
    padding: 24px;
    margin-bottom: 18px;
}

.panel-title {
    margin: 0 0 22px;
}

.live-tag {
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--green);
    background: #163126;
    padding: 7px 9px;
    border-radius: 8px;
}

.chat {
    height: 300px;
    overflow: auto;
    background: #0c0c14;
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bubble {
    max-width: 85%;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.6;
}

.bubble.bot {
    background: #201831;
    border: 1px solid #493568;
    align-self: flex-start;
}

.bubble.user {
    background: #312052;
    align-self: flex-end;
}

.composer {
    display: flex;
    gap: 10px;
    margin-top: 13px;
}

.composer input {
    flex: 1;
}

.hint, .muted {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
}

.two-col, .trade-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 18px;
}

.verse-card blockquote {
    font: 500 19px/1.7 'Space Grotesk';
    color: #e3d7ff;
    border-left: 3px solid var(--purple);
    padding-left: 18px;
    margin: 25px 0;
}

.reference {
    font-size: 11px;
    color: #b79cff;
}

.divider {
    height: 1px;
    background: var(--line);
    margin: 25px 0;
}

.panel h3 {
    font: 600 15px 'Space Grotesk';
}

.form-stack {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin-top: 18px;
}

.form-stack label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 11px;
    color: #b6b2ca;
}

.split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

input, textarea {
    width: 100%;
    background: #0b0b13;
    color: var(--text);
    border: 1px solid #333147;
    border-radius: 9px;
    padding: 12px;
    font-size: 12px;
    outline: none;
}

input:focus, textarea:focus {
    border-color: #9266e4;
    box-shadow: 0 0 0 3px #9266e41c;
}

textarea {
    min-height: 90px;
    resize: vertical;
}

.full {
    width: 100%;
}

.result-box {
    background: #171625;
    border: 1px solid var(--line);
    padding: 14px;
    border-radius: 10px;
    color: #d8ceef;
    font-size: 12px;
    line-height: 1.7;
}

.portfolio-list, .item-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 15px;
}

.list-item {
    background: #171622;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    font-size: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    overflow-wrap: anywhere;
}

.list-item small {
    color: var(--muted);
}

.table-wrap {
    overflow: auto;
    font-size: 11px;
    color: #c7c2d8;
}

.table-wrap table {
    border-collapse: collapse;
    width: 100%;
    min-width: 500px;
}

.table-wrap th, .table-wrap td {
    text-align: left;
    padding: 12px;
    border-bottom: 1px solid var(--line);
}

.table-wrap th {
    color: var(--muted);
}

.code-editor {
    min-height: 220px;
    font-family: monospace;
    line-height: 1.6;
    color: #d8c8ff;
}

.preview-box {
    margin-top: 14px;
    border: 1px dashed #49415f;
    border-radius: 10px;
    min-height: 70px;
    padding: 14px;
    background: white;
    color: #111;
    overflow: auto;
}

.preview-box iframe {
    display: block;
    width: 100%;
    min-height: 180px;
    border: 0;
    background: white;
}

.checklist {
    display: flex;
    flex-direction: column;
    gap: 17px;
    margin-top: 24px;
}

.checklist label {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    color: #c3bfd5;
    font-size: 12px;
}

.checklist input {
    width: auto;
    accent-color: var(--purple);
}

footer {
    text-align: center;
    color: #55536b;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 35px 0 8px;
}

@media (max-width: 1000px) {
    .sidebar { width: 205px; }
    .main { padding: 0 22px; }
    .launch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .orb { transform: scale(.8); margin-right: 0; }
}

@media (max-width: 700px) {
    .app-shell { display: block; }
    .sidebar {
        width: 100%;
        padding: 12px;
        display: block;
        border-right: 0;
        border-bottom: 1px solid var(--line);
    }
    .brand { padding: 0 8px 12px; }
    .nav-label { display: none; }
    .sidebar .nav {
        display: inline-block;
        padding: 9px 10px;
        margin: 2px;
        font-size: 11px;
    }
    .sidebar-bottom { display: none; }
    .main { padding: 0 14px; }
    .topbar { padding: 18px 0; }
    .topbar h1 { font-size: 23px; }
    .hero { padding: 23px; min-height: 260px; }
    .orb { display: none; }
    .two-col, .trade-grid { grid-template-columns: 1fr; }
    .stats { gap: 8px; }
    .stat { padding: 13px; }
    .stat strong { font-size: 23px; }
    .launch-grid { gap: 9px; }
    .launch-card { padding: 13px; }
    .panel { padding: 17px; }
    .credits { font-size: 10px; }
    .top-actions { gap: 8px; }
}
